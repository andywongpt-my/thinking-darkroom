{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "vercel-out",
  "buildCommand": "rm -f bootstrap/cache/packages.php bootstrap/cache/services.php bootstrap/cache/config.php && npm ci --no-audit --no-fund && npm run build && mkdir -p vercel-out/build && cp -r public/build/. vercel-out/build/ && cp public/favicon.ico public/robots.txt vercel-out/",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.8.0" },
    "api/storage.php": { "runtime": "vercel-php@0.8.0" }
  },
  "rewrites": [
    { "source": "/storage/(.*)", "destination": "/api/storage.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ],
  "env": {
    "APP_NAME": "Thinking Darkroom",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://thinking-darkroom.vercel.app",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "LARAVEL_STORAGE_PATH": "/tmp/storage",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "SSR_TEMP_PATH": "/tmp/ssr",
    "CACHE_STORE": "file",
    "SESSION_DRIVER": "file",
    "LOG_CHANNEL": "stderr",
    "LOG_LEVEL": "debug",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite",
    "NODE_PATH": "node"
  }
}
